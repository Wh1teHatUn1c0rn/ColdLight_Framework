# DELIBERATELY NOT IGNORED:
#   .coldlight/baseline.json  -- the accepted-findings baseline is meant to be
#   committed and reviewed, so the whole team shares one accepted state and
#   changes to it show up in review.
!.coldlight/
!.coldlight/baseline.json

